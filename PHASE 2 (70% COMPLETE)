import qrcode
import cv2
import os

def encode_qr():
    text = input("\nEnter text or URL: ").strip()

    if text == "":
        print("Error: Text or URL cannot be empty.")
        return

    filename = input("Enter output filename (default: myqr.png): ").strip()

    if filename == "":
        filename = "myqr.png"

    if not filename.lower().endswith(".png"):
        filename += ".png"

    try:
        qr = qrcode.QRCode(
            version=1,
            error_correction=qrcode.constants.ERROR_CORRECT_L,
            box_size=10,
            border=4
        )

        qr.add_data(text)
        qr.make(fit=True)

        img = qr.make_image(
            fill_color="black",
            back_color="white"
        )

        img.save(filename)

        print("\nQR Code generated successfully!")
        print("Saved as:", filename)

    except Exception as e:
        print("Error while generating QR Code:", e)

def decode_qr():
    filename = input("\nEnter QR image filename: ").strip()

    if filename == "":
        print("Error: Filename cannot be empty.")
        return

    if not os.path.exists(filename):
        print("Error: Image file not found.")
        return

    try:
        image = cv2.imread(filename)

        if image is None:
            print("Error: Unable to read the image.")
            return

        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

        detector = cv2.QRCodeDetector()

        data, points, _ = detector.detectAndDecode(gray)

        if data:
            print("\nQR Code detected successfully!")
            print("Decoded Data:", data)

            cv2.imshow("QR Code", image)
            cv2.waitKey(2000)
            cv2.destroyAllWindows()

        else:
            print("\nQR Code was not detected in the image.")

    except Exception as e:
        print("Error while decoding QR Code:", e)

def show_menu():
    print("\n================================")
    print("       QR CODE ENCODER")
    print("          & DECODER")
    print("================================")
    print("1. Encode QR Code")
    print("2. Decode QR Code")
    print("3. Exit")
    print("================================")

def main():

    while True:

        show_menu()

        try:
            choice = int(input("Enter your choice: "))

        except ValueError:
            print("\nPlease enter a valid number.")
            continue

        if choice == 1:
            encode_qr()

        elif choice == 2:
            decode_qr()

        elif choice == 3:
            print("\nThank you for using QR Code Encoder & Decoder!")
            break

        else:
            print("\nInvalid choice! Please select 1, 2 or 3.")

if __name__ == "__main__":
    main()
